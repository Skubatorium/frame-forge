# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# OS
.DS_Store

# --- FrameForge Projekt-Daten ---
# Projekte werden getrackt, aber nur ihre Konfiguration und der Index.
# Alles Schwere (Medien, Proxies, Renders, Musik) bleibt draussen.
projects/*/music/*
!projects/*/music/analysis/
projects/*/media/
projects/*/exports/*/preview/
projects/*/exports/*/final/
projects/*/exports/*/overlays/
projects/*/exports/*/map/
projects/*/exports/*/nle/
projects/*/exports/*/report.md
projects/*/design/fonts/
projects/*/design/assets/
projects/*/.state.lock
projects/*/index/assets.json.lock

# Gesichtserkennung: biometrische Daten (Encodings), niemals ins Repo (frameforge faces)
projects/*/index/people.json
projects/*/index/people_clusters.json

# Cache (liegt normalerweise in ~/.cache/frameforge, hier als Fallback)
.cache/
cache/

# Testartefakte
tests/tmp/

# --- web/ Reise-Mini-Sites ---
# Struktur und Quelltext werden getrackt, Medien nicht.
web/sites/*/public/video/*
!web/sites/*/public/video/README.md
# Website-Bilder und -Schriften gehoeren zum Deliverable und werden versioniert
# (wenige MB). Draussen bleiben nur die Videos und das Quellmaterial.
# Schriften liegen als TTF im Repo (OFL, ~2,3 MB) - die Seite darf keine externen Requests machen.
web/sites/*/content/media/
.thumbnail
