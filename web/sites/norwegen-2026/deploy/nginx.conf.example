# norwegen.scoobus.de — statische Reise-Site hinter Basic Auth
#
# Nach /etc/nginx/sites-available/norwegen.scoobus.de kopieren.
# TLS-Block ergaenzt certbot beim ersten Lauf selbst.

server {
    listen 80;
    listen [::]:80;
    server_name norwegen.scoobus.de;

    root /var/www/norwegen.scoobus.de;
    index index.html;

    # --- Zugangsschutz -----------------------------------------------------
    # Gilt fuer alles, auch fuer die MP4-Direktlinks.
    auth_basic           "Norwegen 2026";
    auth_basic_user_file /etc/nginx/.htpasswd-norwegen;

    # --- Suchmaschinen aussperren ------------------------------------------
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location = /robots.txt {
        auth_basic off;
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # --- Videos ------------------------------------------------------------
    # Kein gzip auf MP4 (bringt nichts und stoert Range-Requests),
    # kein Buffering, damit das Springen im Player sofort reagiert.
    location /video/ {
        gzip off;
        sendfile on;
        tcp_nopush on;
        add_header Accept-Ranges bytes always;
        add_header Cache-Control "private, max-age=86400" always;

        # 4K-Fassungen sollen heruntergeladen und nicht im Tab abgespielt werden
        location ~* -4k\.mp4$ {
            add_header Content-Disposition "attachment" always;
            add_header Accept-Ranges bytes always;
        }
    }

    # --- Statisches --------------------------------------------------------
    location ~* \.(css|js|woff2|jpg|jpeg|png|webp|svg)$ {
        expires 7d;
        add_header Cache-Control "private, max-age=604800";
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml text/html;
    gzip_min_length 1024;

    location / {
        try_files $uri $uri/ =404;
    }

    client_max_body_size 1m;   # es wird nichts hochgeladen
    access_log /var/log/nginx/norwegen.access.log;
    error_log  /var/log/nginx/norwegen.error.log;
}
