{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/film/**",
              "components/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bangers|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Bangers, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|variant|href|download|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: as, variant, href, download, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CastMember'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|photo|role|alt|groom|key|ref|className|style|children)$/]",
        "message": "<CastMember> doesn't accept that prop. Declared props: name, photo, role, alt, groom."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarkerCaption'] > JSXAttribute > JSXIdentifier[name!=/^(?:rotate|children|key|ref|className|style|children)$/]",
        "message": "<MarkerCaption> doesn't accept that prop. Declared props: rotate, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|tone|children|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: mark, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:quiet|loud)$/]",
        "message": "<Notice> tone must be one of 'quiet' | 'loud'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|sub|image|imageAlt|variant|children|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: kicker, title, sub, image, imageAlt, variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:loud|quiet)$/]",
        "message": "<PageHeader> variant must be one of 'loud' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayTeaser'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|poster|title|meta|alt|key|ref|className|style|children)$/]",
        "message": "<PlayTeaser> doesn't accept that prop. Declared props: href, poster, title, meta, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute > JSXIdentifier[name!=/^(?:wide|children|key|ref|className|style|children)$/]",
        "message": "<Prose> doesn't accept that prop. Declared props: wide, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='QualityOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|spec|text|hint|tag|recommended|action|key|ref|className|style|children)$/]",
        "message": "<QualityOption> doesn't accept that prop. Declared props: title, spec, text, hint, tag, recommended, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|label|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|tone|size|still|key|ref|className|style|children)$/]",
        "message": "<Sticker> doesn't accept that prop. Declared props: glyph, tone, size, still."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:pink|gold|cyan)$/]",
        "message": "<Sticker> tone must be one of 'pink' | 'gold' | 'cyan'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Sticker> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VideoPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|rows|key|ref|className|style|children)$/]",
        "message": "<VideoPanel> doesn't accept that prop. Declared props: title, text, rows."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
